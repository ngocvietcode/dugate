+  const compact = String(value).replace(/[\s.\-/_]/g, '').toUpperCase();
+  if (/^\d+$/.test(compact)) return compact.length >= 9 ? compact : null;
+  if (/^[A-Z0-9]{6,20}$/.test(compact) && /\d/.test(compact)) return compact;
