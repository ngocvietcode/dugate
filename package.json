{
  "name": "dugate",
  "version": "0.2.0",
  "description": "Convert Word & PDF to AI-ready Markdown with image descriptions",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2023",
    "worker:dev": "npx tsx worker.ts",
    "worker:build": "npx esbuild worker.ts --bundle --platform=node --target=node20 --outfile=worker.js --external:ioredis --external:bullmq --external:mammoth --external:sharp --external:openai --external:pdf-parse --alias:@=.",
    "build": "next build",
    "start": "next start -p 2025",
    "lint": "next lint",
    "test": "jest",
    "test:operations-rollout-smoke": "jest --runInBand --runTestsByPath tests/operations-request-tracking/rollout-smoke.test.ts tests/operations-ui/business-dashboard-hook.test.ts",
    "seed": "npx tsx lib/db/seed.ts",
    "sync:loan-catalogs": "node scripts/sync-loan-catalogs.mjs",
    "gen:loan-doc-schemas": "node scripts/gen-loan-doc-schemas.mjs",
    "backfill:operations-request-tracking": "npx tsx scripts/backfill-operations-request-tracking.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/lib-storage": "^3.1030.0",
    "@bull-board/api": "^6.21.0",
    "@bull-board/express": "^6.21.0",
    "@bull-board/hono": "^6.21.0",
    "@dagrejs/dagre": "^3.1.2",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.13",
    "@tailwindcss/typography": "^0.5.19",
    "@xyflow/react": "^12.12.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.73.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastest-levenshtein": "1.0.16",
    "graphology": "0.26.0",
    "hono": "^4.12.12",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.6.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "next-swagger-doc": "^0.4.1",
    "next-themes": "^0.4.6",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "postgres": "^3.4.9",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "simple-statistics": "7.8.8",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.32.1",
    "xlsx": "^0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "ajv": "8.17.1",
    "dotenv": "^17.4.0",
    "fast-check": "^4.7.0",
    "jest": "^30.3.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
