MOCK_PORT=3099
MOCK_API_KEY=DUMMY_SECRET_KEY
MOCK_DELAY_MS=300

# TLS — the service listens on HTTPS only. The pair is generated at runtime
# (container entrypoint, or `npm run certs` for a bare-metal run) and is never
# committed. Override these only if you keep the material elsewhere.
MOCK_CERT_DIR=./certs
# MOCK_TLS_KEY=./certs/mock-service.key
# MOCK_TLS_CERT=./certs/mock-service.crt
MOCK_CERT_DAYS=3650
