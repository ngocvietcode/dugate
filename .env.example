# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dugate

# NextAuth (generate a unique value: `openssl rand -hex 32`)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:2023

# Encryption key for API key storage (generate and retain a unique 32+ character value)
ENCRYPTION_KEY=

# Internal API secret — REQUIRED for /api/internal/recover-stalled (GET + POST).
# Generate a distinct value, then send it as: Authorization: Bearer <secret>.
# The in-process automated reaper does NOT use this HTTP secret.
INTERNAL_API_SECRET=

# AI (optional — can also configure via UI at /settings)
# GEMINI_API_KEY=your-key-here

# OIDC / SSO — REQUIRED. This application is SSO-only: there is no local
# username/password login, so sign-in is impossible without all three values.
# There is no separate on/off switch — these credentials being present IS the
# configuration. Register <NEXTAUTH_URL>/api/auth/callback/oidc as a redirect URI
# with the IDP. Give OIDC_ISSUER the base URL only; the discovery path is appended.
OIDC_ISSUER=https://your-idp.example.com/realms/dugate
OIDC_CLIENT_ID=dugate
OIDC_CLIENT_SECRET=your-client-secret

# File paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# ─── Queue / Redis job retention (Ops quyet gia tri) ─────────────────────────
# Tuoi toi da cua job (completed + failed) truoc khi Redis tu don. Don vi: ms.
# MOT env duy nhat, dung chung cho ca completed va failed.
# 86400000 = 1 ngay | 259200000 = 3 ngay | 604800000 = 7 ngay (fallback trong code)
# CANH BAO: truoc thay doi nay removeOnComplete hardcode 1 gio. Neu khong set env
# -> fallback 7 ngay -> retention job completed tang x168. Lan deploy dau nen dat
# gia tri THAP truoc (vi du 86400000), do, roi nang dan.
QUEUE_JOB_EXPIRE_MS=604800000
# Tran so luong job giu lai moi trang thai, moi queue. Chan burst (age mot minh khong chan duoc).
QUEUE_JOB_MAX_COUNT=1000
# So dong log toi da moi job (BullMQ keepLogs). Tran cung cho Redis list bull:<queue>:<jobId>:logs.
KEEP_JOB_LOGS=100

# ─── Queue backlog cleanup (scheduler trong worker.ts) ────────────────────────
# Cac option o tren la JOB option -> bi dong bang luc `add`, chi ap cho job MOI.
# Scheduler nay don TON DONG: job cu hon QUEUE_JOB_EXPIRE_MS (dung lai env do lam
# `grace` cua queue.clean()), va cat log cua job cu con trong nguong tuoi.
# Day la thanh phan VINH VIEN, khong phai script one-off: BullMQ chi trim mot queue
# khi co job ket thuc TREN CHINH queue do -> queue cua worker group da ngung dung
# se khong bao gio tu trim.
#
# ⚠️ LAN DEPLOY DAU DAT `false`. Lan don dau chay tren ton dong nhieu thang;
# queue.clean() la Lua script -> block Redis single-thread theo tung lo. Ops chay
# lan dau trong cua so thap diem (BGSAVE truoc — xoa KHONG hoi lai duoc), do metric,
# roi moi bat `true` cho van hanh thuong ngay.
QUEUE_CLEANUP_SCHEDULE_ENABLED=false
# So job moi lo queue.clean(). Nho co chu dich: moi lan goi la mot Lua script block
# Redis, job co list :logs lon lam script nang them.
QUEUE_CLEANUP_BATCH_SIZE=300
# Nghi giua cac lo de Redis kip phuc vu traffic thuong.
QUEUE_CLEANUP_BATCH_DELAY_MS=1000
# Pass cat log job cu (Job.clearLogs -> LTRIM ve KEEP_JOB_LOGS dong cuoi) MA KHONG
# xoa job. Can vi keepLogs bi dong bang luc `add`: job da nam trong Redis tu truoc
# co list log khong gioi han, ma queue.clean() chi giup khi job du tuoi de xoa.
# Giu 100 dong cuoi -> Bull Board van triage duoc (khac han UNLINK xoa trang).
# Co the tat khi ton dong cu da het tuoi.
QUEUE_LOG_TRIM_ENABLED=true
# Tran so job moi queue moi luot cua pass cat log (moi job la mot LTRIM round-trip).
# 0 = khong gioi han (chi nen dung cho lan chay tay co kiem soat).
QUEUE_LOG_TRIM_MAX_JOBS=2000

# ─── Log content redaction / truncation ───────────────────────────────────────
# KEEP_JOB_LOGS chan SO DONG log moi job. Cac env duoi day chan DO DAI moi dong.
# Hai lop doc lap trong lib/log-sanitize.ts:
#   SECRET  — LUON an, moi level, moi mode, moi sink (ke ca error / raw / job.log).
#   CONTENT — prompt, document text, response body, base64: chi an o mode 'redacted'.
#
# Mode CONTENT cua sink stdout duoc suy ra theo thu tu:
#   logger.raw() > LOG_REDACT_MODE=raw > level ERROR = full > con lai = redacted
# Sink job.log() (Bull Board / Redis) LUON redacted, khong co ngoai le.
#
# 'redacted' (default) = giu chinh sach theo level. 'raw' = ep full CONTENT o MOI
# level khi can dieu tra sau. SECRET khong bi anh huong boi gia tri nay.
LOG_REDACT_MODE=redacted
# Nguong cat gia tri string trong `meta`.
LOG_MAX_STRING_LEN=500
# Nguong cat `message` (va error message/stack). Noi hon `meta` vi day la van ban
# chan doan do nguoi viet: cat o 500 se mat ngu canh cua nhung log viet dung.
LOG_MAX_MESSAGE_LEN=2000
# Do sau toi da khi de quy sanitize `meta`. Sau hon -> '[Object]'.
LOG_SANITIZE_MAX_DEPTH=4
# Tran cung MOI STRING cho sink stdout, ap ca o mode raw. 0 = khong gioi han.
# Chi de chong no log, khong phai de che noi dung. stdout co rotation ben ngoai.
LOG_RAW_HARD_CAP=100000
# Tran cung MOI DONG cho sink job.log() -> Redis. Thap hon stdout rat nhieu vi
# BullMQ list `:logs` KHONG co rotation, chi mat khi job bi xoa. Bull Board la
# cong cu triage; noi dung day du van con o stdout va Postgres.
LOG_JOBLOG_HARD_CAP=2000
# Ghi PROMPT va OUTPUT cua moi loi goi LLM vao Bull Board (job.log) de tra loi ngay tren job.
# MAC DINH TAT: prompt chua du lieu khach hang (so dinh danh, ten, dia chi) va list `:logs` nam trong RAM Redis,
# KHONG xoay vong, chi mat khi job bi xoa (QUEUE_JOB_EXPIRE_MS / QUEUE_JOB_MAX_COUNT). Chi bat o moi truong test/dieu tra.
# Secret (api key, bearer, token, mat khau) LUON bi che; base64 cua file KHONG BAO GIO duoc ghi (de giam dung luong). KEEP_JOB_LOGS van chan so dong moi job.
LOG_JOB_LLM_IO=false
# Tran ky tu cho MOI dong prompt/output khi LOG_JOB_LLM_IO=true (prompt kiem tra so bo ~25.000 ky tu).
LOG_JOB_LLM_IO_CAP=60000

# ─── Operation content retention (Postgres, lib/operations/content-retention.ts) ─
# Noi dung request trong bang Operation (parameter, prompt, ket qua, output, chi tiet
# tung buoc, URL file) chi luu N ngay roi bi XOA NOI DUNG (khong xoa row). Metadata,
# trang thai, thoi gian, token, chi phi, loi giu vinh vien cho thong ke / billing.
# Doc lap voi QUEUE_JOB_EXPIRE_MS (Redis, don vi ms). Unset = 7. 0 = tat TTL.
# Prompt / ket qua cua sub-step workflow LUON bi xoa ngay khi workflow ket thuc,
# khong phu thuoc gia tri nay.
# Row tao TRUOC lan chay dau chi bi xoa noi dung khi backfill
# operations_request_tracking_backfill_v1 da phase=complete.
OPERATION_CONTENT_RETENTION_DAYS=7
# So row toi da moi luot (moi gio), xu ly theo lo 200.
OPERATION_CONTENT_PURGE_MAX_PER_RUN=5000
# true = chi dem va log so row se bi xoa noi dung, khong ghi DB.
OPERATION_CONTENT_PURGE_DRY_RUN=false
# true = giu prompt + ket qua cua buoc con workflow (khong co file) de ADMIN xem o trang Operations.
# Noi dung van bi xoa theo OPERATION_CONTENT_RETENTION_DAYS. Mac dinh false (xoa ngay khi workflow ket thuc).
WORKFLOW_SUBSTEP_KEEP_CONTENT=false

# Rate limiting (req/min). Per-API-key limit can be overridden per-profile via ApiKey.rateLimitPerMin.
RATE_LIMIT_API_KEY=100
RATE_LIMIT_IP=30

# Outbound URL policy (comma-separated, exact values; no wildcards).
# Private/on-prem hosts are blocked unless their hostname/IP is listed here.
# ALLOWED_PRIVATE_HOSTS=api.internal.example.com,10.20.30.40
#
# The two origin allowlists below are OPT-IN hardening:
#   - Leave UNSET/empty  → legacy behaviour (any SSRF-validated URL is allowed).
#     The system keeps working exactly as before; no config change required.
#   - Set to exact origins → enforced mode (only listed origins are permitted).
# Include scheme and optional non-default port; paths/queries are ignored.
#
# When set, Profile/inline file download credentials are sent only to these origins.
# ALLOWED_FILE_AUTH_ORIGINS=https://files.example.com,https://api.aws.csp.vpbank.dev
# When set, workflow callback (webhook) requests are allowed only to these origins.
# ALLOWED_WEBHOOK_ORIGINS=https://api.example.com,https://callback.example.com:8443

# ─── Secrets / HashiCorp Vault (IT SEC) ───────────────────────────────────────
# Outbound connector keys (AI Hub / Agent Toolkit) are resolved from Vault at runtime.
# Leave VAULT_ADDR empty to use the 'dev' provider (legacy authSecret fallback / local dev).
# SECRET_PROVIDER: 'vault' | 'dev'  (defaults to 'vault' when VAULT_ADDR is set, else 'dev')
# SECRET_PROVIDER=vault
# VAULT_ADDR=https://secret.aws.platform.vpbank.dev
# VAULT_ROLE_ID=            # AppRole RoleID (issued by Tech Platform, per env)
# VAULT_SECRET_ID=          # AppRole SecretID (issued by Tech Platform, per env)
# VAULT_KV_MOUNT=secret     # DEFAULT KV v2 mount (override per-connector with "<mount>:path")
# VAULT_NAMESPACE=          # optional Vault namespace (Enterprise only; leave empty otherwise)
# VAULT_SECRET_CACHE_TTL_MS=60000     # cache resolved value this long
# VAULT_SECRET_STALE_MAX_MS=600000    # serve stale value up to this long if Vault errors
#
# Per-connector "Vault Secret Path" = the FULL KV path exactly as shown in the Vault UI
# (within the mount), optionally "<mount>:" to target another mount, and "#<field>":
#   eda/rpa/dugate/agent-toolkit#ext-doc-layout    (default mount, field ext-doc-layout)
#   kv-aihub:eda/aihub/shared#api_key              (mount override)
# There is NO hidden path prefix — what you type is what is read.
#
# For local/dev without Vault, provide values as JSON keyed by full path:
#   VAULT_DEV_SECRETS={"eda/rpa/dugate/aihub":"sk-xxx"}

# Server
PORT=2023

# Auto-run Prisma db push + seed on container start (set to false after initial deploy)
MIGRATION=true

# Seed values (used by lib/db/seed.ts — override for security in production)

# Machine-to-machine ADMIN API key for /api/v1. Unrelated to SSO; seeding aborts
# without it.
SEED_ADMIN_KEY=change-this-seed-admin-key-before-use

# Bootstrap ADMIN accounts for an EMPTY database, comma-separated company emails.
# Sign-in is SSO-only with no just-in-time provisioning, so a fresh database has
# nobody able to log in until these rows exist. The username is derived from the
# part before "@" and must match what the IDP presents. Existing environments
# migrate their data instead and can leave this unset — seeding only warns.
SEED_ADMIN_EMAILS=first.admin@example.com,second.admin@example.com
