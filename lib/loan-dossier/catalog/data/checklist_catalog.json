  "conditions": [
    {
      "condition_id": "person_is_married",
      "description": "Người đang chấm đã kết hôn.",
      "condition_source": "OCR",
      "evaluation_mode": "RULE",
      "part_condition_ids": [],
      "input_paths": [
        "map_dossier_roles.customer_360[person_id].marital_status",
        "map_dossier_roles.role_registry[person_id].mapped_evidences[doc_type_key=marriage_certificate]",
        "map_dossier_roles.role_registry[person_id].mapped_evidences[doc_type_key=marital_status_confirmation]"
      ],
      "logic": "ms = customer_360[p].marital_status; nếu ms = MARRIED -> MET; nếu ms ∈ {SINGLE, DIVORCED, WIDOWED} -> NOT_MET; nếu ms = null: có evidence marriage_certificate SUCCESS gán cho p -> MET; ngược lại có evidence marital_status_confirmation SUCCESS gán cho p -> NOT_MET; ngược lại -> INPUT_NOT_PROVIDED.",
      "on_input_missing": "REQUIRED",
      "note": "Chế độ dự phòng (không có role registry): áp dụng nhánh evidence trên toàn hồ sơ."
    },
    {
      "condition_id": "person_is_not_married",
      "description": "Người đang chấm độc thân / ly hôn / góa.",
      "condition_source": "OCR",
      "evaluation_mode": "RULE",
      "part_condition_ids": [],
      "input_paths": [
        "map_dossier_roles.customer_360[person_id].marital_status",
        "map_dossier_roles.role_registry[person_id].mapped_evidences[doc_type_key=marriage_certificate]",
        "map_dossier_roles.role_registry[person_id].mapped_evidences[doc_type_key=marital_status_confirmation]"
      ],
      "logic": "Phủ định của person_is_married: MET <-> NOT_MET; INPUT_NOT_PROVIDED giữ nguyên.",
      "on_input_missing": "REQUIRED",
      "note": null
    },
    {
      "condition_id": "person_has_multiple_id_numbers",
      "description": "OCR phát hiện người đang chấm có ≥ 2 số CMND/CCCD khác nhau.",
      "condition_source": "OCR",
      "evaluation_mode": "RULE",
      "part_condition_ids": [],
      "input_paths": [
        "map_dossier_roles.role_registry[person_id].declared_id_number",
        "map_dossier_roles.role_registry[person_id].current_id_number",
        "map_dossier_roles.role_registry[person_id].historical_id_numbers[]",
        "map_dossier_roles.role_registry[person_id].observed_id_numbers[]"
      ],
      "logic": "ids = tập phân biệt (đã chuẩn hóa IdNumber, bỏ null) của declared_id_number ∪ {current_id_number} ∪ historical_id_numbers ∪ observed_id_numbers; |ids| ≥ 2 -> MET, ngược lại NOT_MET.",
      "on_input_missing": "NOT_REQUIRED",
      "note": "Không có role registry -> INPUT_NOT_PROVIDED."
    },
