{
  "name": "dugate-apps",
  "version": "0.1.0",
  "private": true,
  "description": "dugate Apps layer: business workflows as a service on top of dugate Core (ADR-0002)",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "gen:lac-zod": "tsx scripts/gen-lac-zod.ts",
    "check:lac-zod": "tsx scripts/gen-lac-zod.ts --check",
    "server": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "db:migrate": "tsx src/platform/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/proto": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "pg": "^8.16.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^22",
    "@types/pg": "^8",
    "eslint": "^10",
    "json-schema-to-zod": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
